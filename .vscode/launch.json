{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug current TS file",
            "runtimeExecutable": "node",
            "program": "${file}",
            "env": {
                "DEBUG": "1"
            },
            "cwd": "${workspaceFolder}",
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}
