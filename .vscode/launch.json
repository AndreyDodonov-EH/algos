{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Debug current TS file",
            "runtimeExecutable": "node",
            "runtimeArgs": [
                "--enable-source-maps",
                "-r",
                "ts-node/register/transpile-only"
            ],
            "program": "${file}",
            "sourceMaps": true,
            "outFiles": [],
            "env": {
                "DEBUG": "1"
            },
            "cwd": "${workspaceFolder}",
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}
